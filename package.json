{
  "name": "qai-growth-compass",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint:cjk && npm run lint && npm run check:dim && npm run check:dep-sync && npm run check:env && npm run check:api-imports && npm run check:runtime-pin && npm run check:doc-anchors && npm run check:crons && npm run check:ghl-transport && npm run check:legacy-columns && npm run check:rpc-contract && tsc -b && vite build && npm run check:bundle",
    "preview": "vite preview",
    "verify": "npm run build && npm test && npm run check:deno && npm run test:deno && npm run check:cross",
    "deploy:functions": "npm run verify && node scripts/check-env.mjs --print && supabase functions deploy",
    "lint": "eslint .",
    "lint:cjk": "eslint --config eslint.cjk.config.js \"src/**/*.{ts,tsx}\"",
    "check:bundle": "node scripts/check-bundle-secrets.mjs",
    "check:dim": "node scripts/check-dim-color-usage.mjs",
    "check:dep-sync": "node scripts/check-dep-sync.mjs",
    "check:cross": "node scripts/check-cross-runtime.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:deno": "cd supabase/functions && deno task test",
    "check:deno": "cd supabase/functions && deno task check",
    "fonts:subset": "node scripts/subset-fonts.mjs",
    "check:env": "node scripts/check-env.mjs",
    "smoke": "node scripts/smoke-deploy.mjs",
    "config:check": "node scripts/apply-config.mjs --check",
    "config:apply": "node scripts/apply-config.mjs",
    "check:api-imports": "node scripts/check-api-imports.mjs",
    "check:runtime-pin": "node scripts/check-runtime-pin.mjs",
    "check:doc-anchors": "node scripts/check-doc-anchors.mjs",
    "check:crons": "node scripts/check-crons.mjs",
    "check:ghl-transport": "node scripts/check-ghl-transport.mjs",
    "check:legacy-columns": "node scripts/check-legacy-columns.mjs",
    "check:rpc-contract": "node scripts/check-rpc-contract.mjs",
    "tags:list": "deno run --allow-read --config supabase/functions/deno.json scripts/print-ghl-tags.ts",
    "seed:test": "node scripts/seed-test-data.ts",
    "seed:test:clean": "node scripts/seed-test-data.ts --clean --yes"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@sparticuz/chromium": "^131.0.1",
    "@supabase/supabase-js": "2.110.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "libphonenumber-js": "1.13.9",
    "lucide-react": "^0.462.0",
    "puppeteer-core": "^23.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vercel/node": "^3.2.29",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^5.4.11",
    "vitest": "4.1.10"
  }
}
