# ============================================================================
# 前端(会被打进客户端 bundle —— 只有本节的变量允许带 VITE_ 前缀)
# ============================================================================
VITE_APP_BASE_URL=https://compass.qiai.tech
VITE_CDN_FONT_BASE=https://cdn.qiai.tech/fonts/
VITE_SUPABASE_URL=
# 新格式(sb_publishable_…)。与下面的 legacy 二选一,配了这个就优先用它。
# ⚠️ VITE_ 是 build-time:换值必须重新构建 + 部署,改环境变量不够
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# 本地开发时把 /api 代理到线上或 vercel dev(可选)
VITE_API_PROXY=

# ============================================================================
# Vercel 服务端(绝对不要加 VITE_ 前缀,加了就会泄进浏览器)
# ============================================================================
SUPABASE_URL=
# 新格式,与下面两个 legacy 各自二选一(新的优先)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PDF 渲染器(api/render-pdf.ts)要打开报告页,所以 Vercel 这边也要一份 APP_BASE_URL。
# 注意:同名变量在 Supabase Edge Function secrets 里【也】有一份(魔法链接用),
# 两个平台各配各的,改域名时两处都要改。
APP_BASE_URL=https://compass.qiai.tech
SESSION_SECRET=
INTERNAL_FN_SECRET=
# Vercel Cron 的鉴权(Vercel 会带 Authorization: Bearer <这个值>)
CRON_SECRET=
CDN_FONT_BASE=https://cdn.qiai.tech/fonts/

# ============================================================================
# Supabase Edge Function secrets(用 `supabase secrets set` 配置,不放这里)
#   QAI_WEBHOOK_SECRET / GHL_PRIVATE_TOKEN / GHL_LOCATION_ID
#   GHL_RESEND_WEBHOOK_URL / APP_BASE_URL / SESSION_SECRET
#   LOGIN_HASH_PEPPER / INTERNAL_FN_SECRET
# ============================================================================

# 本地 CLI 用
SUPABASE_PROJECT_REF=
